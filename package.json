{
  "name": "tempering-ai",
  "version": "0.1.3",
  "description": "An interactive AI prompt generator for your terminal.",
  "module": "index.ts",
  "type": "module",
  "scripts": {
    "build": "bun build index.ts --target node --outfile dist/tempering-ai.js",
    "build:native": "bun build index.ts --compile --outfile dist/tempering-ai"
  },
  "bin": {
    "tempering-ai": "./dist/tempering-ai.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/osinnanna/tempering-ai.git"
  },
  "keywords": [
    "ai",
    "cli",
    "companion",
    "terminal"
  ],
  "devDependencies": {
    "@types/bun": "latest",
    "@types/readline-sync": "^1.4.8"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@inquirer/prompts": "^8.2.0",
    "@openrouter/ai-sdk-provider": "^2.0.0",
    "@openrouter/sdk": "^0.4.0",
    "ai": "^6.0.48",
    "ora": "^9.1.0",
    "readline-sync": "^1.4.10"
  }
}
